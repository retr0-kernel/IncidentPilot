{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "incidentpilot",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "CONTEXT_ID_PREFIX": "NWE",
    "CONTEXT_SEQUENCE_WIDTH": "3",
    "LOG_LEVEL": "info"
  },
  "ai": { "binding": "AI", "remote": true },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/oauth/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "IncidentPilotAgent",
        "name": "IncidentPilotAgent"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["IncidentPilotAgent"],
      "tag": "v1"
    }
  ]
}
