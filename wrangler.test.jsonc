{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "incidentpilot-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "incidentpilot-test-db",
      "database_id": "00000000-0000-4000-8000-000000000099",
      "migrations_dir": "src/db/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "IncidentPilotAgent",
        "name": "IncidentPilotAgent"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["IncidentPilotAgent"],
      "tag": "v1"
    }
  ]
}
